func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity += get_gravity() * delta
	
	if Input.is_action_just_pressed("ui_up") and is_on_floor():
		velocity.y = Jump_Velocity
		
	var direction := Input.get_axis("ui_left", "ui_right")
	if direction:
		velocity.x = direction * speed
		#print(direction)
	else:
		velocity.x = move_toward(velocity.x, 0, speed)
			
	anims(direction)
	attacks()
	move_and_slide()
	if is_on_floor() and slamming:
		$Area2D2/AnimatedSprite2D.position.y = $Sprite2D.position.y + 500
		$Area2D2/AnimatedSprite2D.play("default")
		slamming = false

var dash_available = true
@export var dash = 19
@export var slamv = 2000
var slamming = false



func dashcd():
	dash_available = false
	await get_tree().create_timer(.7).timeout
	dash_available = true

func attacks():
	if not is_on_floor():
		if dash_available == true and Input.is_action_just_pressed("Dash"):
			$Area2D2/DashAnim.play("default")
			velocity.x *= dash
			
			dashcd()
		if Input.is_action_just_pressed("S"):
			slamming = true
			velocity.y = slamv
	if Input.is_action_just_pressed("W"):
		if is_on_floor():
			pass
